<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude encrypted token storage — Keystore keys are device-specific -->
        <exclude domain="sharedpref" path="AuthPrefs"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="AuthPrefs"/>
    </device-transfer>
</data-extraction-rules>
