<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="20dp"
        android:background="@drawable/widget_background">

        <!-- Header: icon ví + nhãn + nút + -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TỔNG TÀI SẢN"
                android:textColor="#666666"
                android:textSize="9sp"
                android:drawableStart="@drawable/ic_widget_wallet"
                android:drawablePadding="5dp" />

            <ImageButton
                android:id="@+id/btn_add_tx"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="8dp"
                android:padding="5dp"
                android:background="@drawable/widget_btn_add_bg"
                android:src="@drawable/ic_widget_add"
                android:contentDescription="Thêm giao dịch" />

        </LinearLayout>

        <!-- Tổng tài sản: [₫ 14sp] + [số tiền 24sp bold] -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:layout_marginTop="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₫"
                android:textColor="#757575"
                android:textSize="14sp"
                android:layout_marginBottom="3dp" />

            <TextView
                android:id="@+id/widget_total_assets"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#1A237E"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginStart="1dp" />

        </LinearLayout>

        <!-- Divider 1 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="4dp"
            android:background="#E5E7EB" />

        <!-- Tài sản ròng: icon xu hướng + nhãn trái + số phải -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/widget_net_worth_label"
                android:textColor="#666666"
                android:textSize="9sp"
                android:drawableStart="@drawable/ic_widget_trend"
                android:drawablePadding="5dp" />

            <TextView
                android:id="@+id/widget_net_worth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₫0"
                android:textColor="#374151"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Divider trước phần giao dịch (ẩn mặc định) -->
        <TextView
            android:id="@+id/widget_tx_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="4dp"
            android:background="#E5E7EB"
            android:visibility="gone" />

        <!-- Phần giao dịch gần nhất (ẩn mặc định) -->
        <LinearLayout
            android:id="@+id/widget_tx_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Hàng 1 -->
            <LinearLayout
                android:id="@+id/widget_tx_row_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="3dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/widget_tx_icon_1"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_widget_expense" />

                <TextView
                    android:id="@+id/widget_tx_name_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:textSize="9sp"
                    android:textColor="#374151"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="—" />

                <TextView
                    android:id="@+id/widget_tx_amount_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="#EF4444"
                    android:text="" />

            </LinearLayout>

            <!-- Hàng 2 -->
            <LinearLayout
                android:id="@+id/widget_tx_row_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="3dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/widget_tx_icon_2"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_widget_expense" />

                <TextView
                    android:id="@+id/widget_tx_name_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:textSize="9sp"
                    android:textColor="#374151"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="—" />

                <TextView
                    android:id="@+id/widget_tx_amount_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="#EF4444"
                    android:text="" />

            </LinearLayout>

            <!-- Hàng 3 -->
            <LinearLayout
                android:id="@+id/widget_tx_row_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/widget_tx_icon_3"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_widget_expense" />

                <TextView
                    android:id="@+id/widget_tx_name_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:textSize="9sp"
                    android:textColor="#374151"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="—" />

                <TextView
                    android:id="@+id/widget_tx_amount_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="#EF4444"
                    android:text="" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
