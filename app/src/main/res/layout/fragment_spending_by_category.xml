<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp">

    <!-- FrameLayout chứa 4 trạng thái: content / loading / empty / error -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- ── STATE: Content (donut + legend) ─────────────────────── -->
        <LinearLayout
            android:id="@+id/layout_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <!-- Tiêu đề -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chi tiêu theo danh mục"
                android:textColor="#1A1A1A"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Phân bổ chi tiêu tháng này"
                android:textColor="#9CA3AF"
                android:textSize="13sp" />

            <!-- Hàng chart + legend -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Cột trái: Donut chart 140×140dp (cố định để không bị ép nhỏ) -->
                <FrameLayout
                    android:layout_width="140dp"
                    android:layout_height="140dp">

                    <com.github.mikephil.charting.charts.PieChart
                        android:id="@+id/pie_chart"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </FrameLayout>

                <!-- Cột phải: Legend danh mục (fill phần còn lại) -->
                <LinearLayout
                    android:id="@+id/layout_legend"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical" />

            </LinearLayout>
        </LinearLayout>

        <!-- ── STATE: Loading skeleton ──────────────────────────────── -->
        <LinearLayout
            android:id="@+id/layout_loading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="visible">

            <!-- Skeleton tiêu đề -->
            <View
                android:layout_width="180dp"
                android:layout_height="16dp"
                android:background="#F3F4F6" />

            <View
                android:layout_width="140dp"
                android:layout_height="12dp"
                android:layout_marginTop="8dp"
                android:background="#F3F4F6" />

            <!-- Skeleton chart + legend -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Skeleton donut -->
                <View
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:background="@drawable/bg_skeleton_circle" />

                <!-- Skeleton legend rows -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <View android:layout_width="match_parent" android:layout_height="12dp" android:background="#F3F4F6" />
                    <View android:layout_width="120dp" android:layout_height="12dp" android:layout_marginTop="16dp" android:background="#F3F4F6" />
                    <View android:layout_width="match_parent" android:layout_height="12dp" android:layout_marginTop="16dp" android:background="#F3F4F6" />
                    <View android:layout_width="100dp" android:layout_height="12dp" android:layout_marginTop="16dp" android:background="#F3F4F6" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ── STATE: Empty ─────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/layout_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="32dp"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chi tiêu theo danh mục"
                android:textColor="#1A1A1A"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_gravity="start" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Phân bổ chi tiêu tháng này"
                android:textColor="#9CA3AF"
                android:textSize="13sp"
                android:layout_gravity="start" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="💸"
                android:textSize="40sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Chưa có chi tiêu tháng này"
                android:textColor="#9CA3AF"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- ── STATE: Error ─────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/layout_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:paddingBottom="28dp"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chi tiêu theo danh mục"
                android:textColor="#1A1A1A"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_gravity="start" />

            <TextView
                android:id="@+id/tv_error_msg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Đã có lỗi xảy ra"
                android:textColor="#6B7280"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_retry"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Thử lại"
                android:textSize="13sp" />
        </LinearLayout>

    </FrameLayout>
</androidx.cardview.widget.CardView>
