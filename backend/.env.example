# Copy file này thành .env và điền giá trị thật (KHÔNG commit .env)

# Neon PostgreSQL
DB_URL=jdbc:postgresql://<host>/<db>?sslmode=require&channel_binding=require
DB_USERNAME=<username>
DB_PASSWORD=<password>

# JWT — tạo bằng: openssl rand -hex 32
JWT_SECRET=<hex-encoded-256bit-secret>

# Google Gemini
GEMINI_API_KEY=<your-gemini-api-key>
